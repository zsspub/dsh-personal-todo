{
  "name": "dsh-personal-todo",
  "version": "0.1.0",
  "description": "SQLite-backed personal todo tools and Web panel for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./execution-skill": {
      "types": "./lib/types/execution-skill.d.ts",
      "default": "./lib/execution-skill.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "README.zh.md",
    "LICENSE",
    "cordis.patch.yml",
    "assets",
    "lib/*.js",
    "lib/*.d.ts",
    "lib/*.d.ts.map",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:host && pnpm run build:client",
    "build:host": "tsc -p tsconfig.host.json && tsdown --config tsdown.host.config.ts && node scripts/generate-typert.mjs",
    "build:client": "tsc -p tsconfig.client.json && tsdown --config tsdown.client.config.ts && node scripts/normalize-artifacts.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run test:coverage && pnpm pack --dry-run",
    "artifacts:check": "pnpm run build && git diff --exit-code -- lib"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zsspub/dsh-personal-todo.git"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "lucide-react": "^1.42.0",
    "nanostores": "^1.5.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
